# Copy to .env for local development. Real environment variables take precedence.
# Every value below is the default used when the variable is unset.

# TCP port to listen on (binds 0.0.0.0).
PORT=8000
# Log verbosity: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# DEFLATE level 1-9; 0 stores entries uncompressed (STORED method).
ZIP_COMPRESSION_LEVEL=6
# Seconds in-flight requests get to finish after SIGTERM before being aborted.
SHUTDOWN_GRACE_SECONDS=25
# Maximum number of (non-skipped) file parts per request.
MAX_FILES=500
# Maximum concurrent in-flight zip requests per process; excess gets 503 overloaded.
MAX_CONCURRENT_REQUESTS=32
# Abort a request after this many seconds with no bytes read or sent.
IDLE_TIMEOUT_SECONDS=30
# Maximum total duration of a single request, in seconds.
MAX_REQUEST_DURATION_SECONDS=900
# Maximum compressed output buffered in memory while the client is not reading (bytes).
OUTPUT_BUFFER_MAX_BYTES=16777216
