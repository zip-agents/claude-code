# syntax=docker/dockerfile:1
# Development/test toolbox: Python, uv and the archive tools the tests validate with.
# The repository is bind-mounted at /workspace; the virtualenv and uv cache live in named
# volumes. Build with the host UID/GID so files written to the mount stay yours.
ARG PYTHON_IMAGE=python:3.12.8-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.0

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE}
ARG UID=1000
ARG GID=1000
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl unzip p7zip-full \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
RUN (getent group "${GID}" || groupadd --gid "${GID}" dev) \
    && useradd --create-home --uid "${UID}" --gid "${GID}" --shell /bin/bash dev \
    && mkdir -p /venv /cache \
    && chown "${UID}:${GID}" /venv /cache
ENV UV_PROJECT_ENVIRONMENT=/venv \
    UV_CACHE_DIR=/cache \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/venv/bin:${PATH}"
USER ${UID}:${GID}
WORKDIR /workspace
